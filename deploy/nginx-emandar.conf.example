# Add these locations to the existing panel.ceo server block.
# Keep existing TLS, server_name, headers and sibling locations unchanged.

location = /emandar {
  return 301 /emandar/;
}

location ^~ /emandar/api/ {
  proxy_pass http://127.0.0.1:4174/emandar/api/;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
}

location ^~ /emandar/ {
  alias /opt/panel.ceo/emandar/;
  try_files $uri $uri/ /emandar/index.html;
}
