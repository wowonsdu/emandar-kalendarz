{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "main": "functions/index.js",
  "type": "module",
  "scripts": {
    "admin:create": "node scripts/upsert-admin-user.mjs",
    "backfill:firebase": "node scripts/backfill-firebase.mjs",
    "build": "vite build && node scripts/postbuild.mjs",
    "dev": "vite",
    "dev:emu": "vite --mode emulators",
    "demo:seed": "node scripts/seed-demo-auth-accounts.mjs",
    "demo:seed:data": "node scripts/seed-demo-network-and-events.mjs",
    "firebase": "firebase",
    "firebase:login": "firebase login",
    "firebase:projects": "firebase projects:list",
    "firebase:use": "firebase use emandar-app",
    "firebase:deploy": "firebase deploy --only functions,firestore:rules,storage --project emandar-app",
    "emu:start": "firebase emulators:start --only auth,firestore,storage,functions",
    "emu:start:data": "firebase emulators:start --only auth,firestore,storage,functions --import .firebase-emulator-data --export-on-exit .firebase-emulator-data",
    "release:check": "npm run test && npm run test:firebase && npm run build",
    "test": "vitest run src",
    "test:firebase": "node tests/firebase/rules/run-rules-tests.mjs",
    "test:rules": "node tests/firebase/rules/run-rules-tests.mjs"
  },
