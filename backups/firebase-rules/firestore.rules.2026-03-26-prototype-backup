rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth == null ? null : request.auth.uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        (
          ("admin" in request.auth.token) &&
          request.auth.token.admin == true
        ) ||
        (
          hasUserDoc(currentUid()) &&
          (
            optionalField(userDoc(currentUid()).data, "role") == "admin" ||
            optionalField(userDoc(currentUid()).data, "primaryRole") == "admin" ||
            (
              ("roles" in userDoc(currentUid()).data) &&
              "admin" in userDoc(currentUid()).data.roles
            )
          )
        )
      );
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    function hasUserDoc(userId) {
      return userId != null &&
        exists(/databases/$(database)/documents/users/$(userId));
    }

    function hasAppUserDocument() {
      return isSignedIn() && hasUserDoc(currentUid());
    }

    function currentUser() {
      return userDoc(currentUid()).data;
    }

    function currentUserHasRole(role) {
      return hasAppUserDocument() && (
        (("roles" in currentUser()) && role in currentUser().roles) ||
        (("primaryRole" in currentUser()) && currentUser().primaryRole == role) ||
        (("role" in currentUser()) && currentUser().role == role)
      );
    }

    function currentTrainerProfileId() {
      return hasAppUserDocument() &&
        ("trainerProfileId" in currentUser()) &&
        currentUser().trainerProfileId != null
          ? currentUser().trainerProfileId
          : null;
    }

    function currentOrganizerProfileId() {
      return hasAppUserDocument() &&
        ("organizerProfileId" in currentUser()) &&
        currentUser().organizerProfileId != null
          ? currentUser().organizerProfileId
          : null;
    }

    function isOwnUser(userId) {
      return isSignedIn() && currentUid() == userId;
    }

    function canSwitchOwnRole(userId) {
      return isOwnUser(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["role"]) &&
        request.resource.data.role in resource.data.roles;
    }

    function isArchived(data) {
      return ("archivedAt" in data) && data.archivedAt != null;
    }

    function optionalField(data, field) {
      return field in data ? data[field] : null;
    }

    function isSelfManagedEvent(data) {
      return optionalField(data, "brandStatus") == "supported" ||
        data.selfManagedByTrainer == true ||
        optionalField(data, "organizerId") == null;
    }

    function trainerOwnsProfile(trainerId) {
      return hasAppUserDocument() &&
        currentTrainerProfileId() == trainerId;
    }

    function organizerOwnsProfile(organizerId) {
      return hasAppUserDocument() &&
        currentOrganizerProfileId() == organizerId;
    }

    function isRelationParticipant(data) {
      return isAdmin() || (
        isSignedIn() &&
        (
          data.trainerUserId == currentUid() ||
          data.organizerUserId == currentUid()
        )
      );
    }

    function isEventParticipant(data) {
      return isAdmin() || (
        isSignedIn() &&
        (
          data.trainerUserId == currentUid() ||
          data.organizerUserId == currentUid()
        )
      );
    }

    function isPublicEvent(data) {
      return optionalField(data, "isPublished") == true &&
        !isArchived(data) &&
        (
          isSelfManagedEvent(data) ||
          (
            optionalField(data, "trainerCollaborationStatus") == "accepted" &&
            (
              optionalField(data, "organizerCollaborationStatus") == "accepted" ||
              optionalField(data, "organizerCollaborationStatus") == "not-required"
            )
          )
        );
    }

    function relationIdIsDeterministic(relationId) {
      return relationId == request.resource.data.trainerId + "__" + request.resource.data.organizerId;
    }

    function canCreateRelationRequest(relationId) {
      return hasAppUserDocument() &&
        relationIdIsDeterministic(relationId) &&
        request.resource.data.status == "pending" &&
        (
          (
            request.resource.data.requestedBy == "organizer" &&
            organizerOwnsProfile(request.resource.data.organizerId) &&
            request.resource.data.organizerUserId == currentUid()
          ) ||
          (
            request.resource.data.requestedBy == "trainer" &&
            trainerOwnsProfile(request.resource.data.trainerId) &&
            request.resource.data.trainerUserId == currentUid()
          )
        );
    }

    function relationOwnershipUnchanged() {
      return request.resource.data.trainerId == resource.data.trainerId &&
        request.resource.data.organizerId == resource.data.organizerId &&
        request.resource.data.trainerUserId == resource.data.trainerUserId &&
        request.resource.data.organizerUserId == resource.data.organizerUserId;
    }

    function canRespondToPendingRelation() {
      return resource.data.status == "pending" &&
        request.resource.data.status in ["approved", "rejected"] &&
        relationOwnershipUnchanged() &&
        request.resource.data.requestedBy == resource.data.requestedBy &&
        (
          (
            resource.data.requestedBy == "organizer" &&
            resource.data.trainerUserId == currentUid()
          ) ||
          (
            resource.data.requestedBy == "trainer" &&
            resource.data.organizerUserId == currentUid()
          ) ||
          isAdmin()
        );
    }

    function canReopenRelationRequest(relationId) {
      return resource.data.status in ["rejected", "detached"] &&
        canCreateRelationRequest(relationId) &&
        (
          request.resource.data.organizerUserId == currentUid() ||
          request.resource.data.trainerUserId == currentUid() ||
          isAdmin()
        );
    }

    function canDetachRelation() {
      return resource.data.status == "approved" &&
        request.resource.data.status == "detached" &&
        relationOwnershipUnchanged() &&
        (
          resource.data.trainerUserId == currentUid() ||
          resource.data.organizerUserId == currentUid() ||
          isAdmin()
        );
    }

    function trainerProfileMatchesRequest(trainerId) {
      return trainerOwnsProfile(trainerId) &&
        request.resource.data.userId == currentUid() &&
        (
          !exists(/databases/$(database)/documents/trainers/$(trainerId)) ||
          resource.data.userId == currentUid()
        );
    }

    function organizerProfileMatchesRequest(organizerId) {
      return organizerOwnsProfile(organizerId) &&
        request.resource.data.userId == currentUid() &&
        (
          !exists(/databases/$(database)/documents/organizers/$(organizerId)) ||
          resource.data.userId == currentUid()
        );
    }

    function eventChangedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function canUpdateEventCollaboration() {
      return resource != null &&
        !isArchived(resource.data) &&
        trainerOwnsProfile(resource.data.trainerId) &&
        eventChangedKeys().hasOnly(["trainerCollaborationStatus"]) &&
        request.resource.data.trainerCollaborationStatus in ["accepted", "rejected"];
    }

    function canUpdateOrganizerEventCollaboration() {
      return resource != null &&
        !isArchived(resource.data) &&
        organizerOwnsProfile(resource.data.organizerId) &&
        eventChangedKeys().hasOnly(["organizerCollaborationStatus"]) &&
        request.resource.data.organizerCollaborationStatus in ["accepted", "rejected"];
    }

    function canAdminUpdateEventBrandStatus() {
      return resource != null &&
        eventChangedKeys().hasOnly(["brandStatus"]) &&
        request.resource.data.brandStatus in ["official", "supported"];
    }

    function canAdminUpdateEventCollaboration() {
      return resource != null &&
        !isArchived(resource.data) &&
        eventChangedKeys().hasOnly([
          "trainerCollaborationStatus",
          "organizerCollaborationStatus"
        ]) &&
        (
          !("trainerCollaborationStatus" in request.resource.data) ||
          request.resource.data.trainerCollaborationStatus in ["accepted", "rejected"]
        ) &&
        (
          !("organizerCollaborationStatus" in request.resource.data) ||
          request.resource.data.organizerCollaborationStatus in ["accepted", "rejected"]
        );
    }

    function canReadAvailabilitySlot(data) {
      return isAdmin() ||
        data.trainerUserId == currentUid() ||
        (
          hasAppUserDocument() &&
          currentOrganizerProfileId() != null &&
          ("visibleToOrganizerIds" in data) &&
          currentOrganizerProfileId() in data.visibleToOrganizerIds
        );
    }

    function canManageAvailabilitySlot(data) {
      return isAdmin() ||
        (
          trainerOwnsProfile(data.trainerId) &&
          data.trainerUserId == currentUid()
        );
    }

    function canManageOwnTrainerFeed(data) {
      return isAdmin() ||
        (
          trainerOwnsProfile(data.trainerId) &&
          data.trainerUserId == currentUid()
        );
    }

    function isEnrollmentParticipant(data) {
      return isAdmin() ||
        data.trainerUserId == currentUid() ||
        data.organizerUserId == currentUid() ||
        data.submitterUid == currentUid();
    }

    match /users/{userId} {
      allow read: if isAdmin() || isOwnUser(userId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || canSwitchOwnRole(userId);
    }

    match /trainers/{trainerId} {
      allow get, list: if resource != null && ((resource.data.isVisible == true) || hasAppUserDocument());
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.userId == currentUid()
      );
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.userId == currentUid() &&
        request.resource.data.userId == resource.data.userId
      );
      allow delete: if isAdmin() || (
        isSignedIn() &&
        resource.data.userId == currentUid()
      );
    }

    match /organizers/{organizerId} {
      allow get, list: if resource != null && hasAppUserDocument();
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.userId == currentUid()
      );
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.userId == currentUid() &&
        request.resource.data.userId == resource.data.userId
      );
      allow delete: if isAdmin() || (
        isSignedIn() &&
        resource.data.userId == currentUid()
      );
    }

    match /trainerOrganizerRelations/{relationId} {
      allow get, list: if resource != null && isSignedIn() && isRelationParticipant(resource.data);
      allow create: if !exists(/databases/$(database)/documents/trainerOrganizerRelations/$(relationId)) &&
        (isAdmin() || canCreateRelationRequest(relationId));
      allow update: if isAdmin() || (
        !isAdmin() &&
        (canRespondToPendingRelation() || canDetachRelation() || canReopenRelationRequest(relationId))
      );
      allow delete: if isAdmin();
    }

    match /trainingEvents/{eventId} {
      allow get, list: if resource != null && (isPublicEvent(resource.data) || hasAppUserDocument());
      allow create, delete: if false;
      allow update: if (isAdmin() && (canAdminUpdateEventBrandStatus() || canAdminUpdateEventCollaboration())) || (
        !isAdmin() &&
        (canUpdateEventCollaboration() || canUpdateOrganizerEventCollaboration())
      );
    }

    match /availabilitySlots/{slotId} {
      allow get, list: if hasAppUserDocument();
      allow create: if hasAppUserDocument() &&
        canManageAvailabilitySlot(request.resource.data) &&
        request.resource.data.visibility == "approved-organizers";
      allow update: if hasAppUserDocument() &&
        canManageAvailabilitySlot(resource.data) &&
        request.resource.data.trainerId == resource.data.trainerId &&
        request.resource.data.trainerUserId == resource.data.trainerUserId;
      allow delete: if hasAppUserDocument() && canManageAvailabilitySlot(resource.data);
    }

    match /trainerCalendarFeeds/{feedId} {
      allow get, list: if resource != null && isSignedIn() && canManageOwnTrainerFeed(resource.data);
      allow create: if hasAppUserDocument() && canManageOwnTrainerFeed(request.resource.data);
      allow update: if hasAppUserDocument() &&
        canManageOwnTrainerFeed(resource.data) &&
        request.resource.data.trainerId == resource.data.trainerId &&
        request.resource.data.trainerUserId == resource.data.trainerUserId;
      allow delete: if hasAppUserDocument() && canManageOwnTrainerFeed(resource.data);
    }

    match /trainerExternalBusyMonths/{monthId} {
      allow get, list: if resource != null && (isAdmin() || (
        hasAppUserDocument() &&
        currentTrainerProfileId() == resource.data.trainerId
      ));
      allow create, update, delete: if false;
    }

    match /enrollmentRequests/{requestId} {
      allow get, list: if resource != null && isSignedIn() && isEnrollmentParticipant(resource.data);
      allow create, update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow get, list: if resource != null && isSignedIn() && (isAdmin() || resource.data.userId == currentUid());
      allow create, delete: if false;
      allow update: if isAdmin() || (
        resource != null &&
        isSignedIn() &&
        resource.data.userId == currentUid() &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.title == resource.data.title &&
        request.resource.data.body == resource.data.body &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.entityType == resource.data.entityType &&
        request.resource.data.readAt != null
      );
    }

    match /accountRequests/{requestId} {
      allow get, list: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /trainerPublicationApprovals/{approvalId} {
      allow get, list: if resource != null && (
        isAdmin() || (
          isSignedIn() && (
            resource.data.requesterUserId == currentUid() ||
            resource.data.targetTrainerUserId == currentUid()
          )
        )
      );
      allow create, update, delete: if false;
    }

    match /trainerAccountApprovals/{approvalId} {
      allow get, list: if resource != null && (
        isAdmin() || (
          isSignedIn() && (
            resource.data.requesterUserId == currentUid() ||
            resource.data.targetTrainerUserId == currentUid()
          )
        )
      );
      allow create, update, delete: if false;
    }

    match /app_meta/publicSettings {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    match /app_meta/{docId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
