NODE_ENV=production
HOST=127.0.0.1
PORT=4174
BASE_PATH=/emandar
PUBLIC_APP_URL=https://panel.ceo/emandar
DATABASE_URL=postgres://emandar_prod:change-me@127.0.0.1:5432/emandar_prod
SESSION_SECRET=change-me-to-a-long-random-secret
SESSION_TTL_SECONDS=2592000
CORS_ALLOWED_ORIGINS=https://panel.ceo
ALLOW_LEGACY_STORE_API=false
SMSAPI_TEST_MODE=true
# SMSAPI_TEST_MODE=false is required for real launch after sender and billing are verified.
# SMSAPI_TOKEN=
# SMSAPI_FROM=
SMS_CODE_TTL_SECONDS=300
SEED_STORE_PATH=/opt/panel.ceo/emandar-api/seed-data/seed-store.json
UPLOAD_STORAGE_PATH=/opt/panel.ceo/emandar-data/uploads
UPLOADS_PUBLIC_PATH=/emandar/uploads
